BasedOnStyle: Google
DerivePointerAlignment: false
PointerAlignment: Left
IncludeBlocks: Regroup
IncludeCategories:
  # C system headers
  - Regex: '^<.*\.h>$'
    Priority: 1
  # C++ standard library
  - Regex: '^<[a-z_]+>$'
    Priority: 2
  # Other libraries
  - Regex: '^<.*>$'
    Priority: 3
  # Project headers
  - Regex: '.*'
    Priority: 4
FixNamespaceComments: false
