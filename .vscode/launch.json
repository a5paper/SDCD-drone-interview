{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "Debug DroneSimulator (gdb)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/DroneSimulator/DroneSimulator",
            "cwd": "${workspaceFolder}",
            "MIMode": "gdb",
            "miDebuggerPath": "/usr/bin/gdb",
            "preLaunchTask": "build (Debug)",
            "setupCommands": [
                { "text": "-enable-pretty-printing", "ignoreFailures": true },
                { "text": "-gdb-set print object on", "ignoreFailures": true }
            ]
        }
    ]
}
